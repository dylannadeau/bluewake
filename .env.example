# Copy to .env and fill in. All sources are free tier.

# aisstream.io — sign up at https://aisstream.io
AISSTREAM_API_KEY=

# AISHub — requires a member account (https://www.aishub.net)
AISHUB_USERNAME=

# Global Fishing Watch — token from https://globalfishingwatch.org/our-apis/
GFW_API_TOKEN=

# Phase 4: email alerts
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_FROM_ADDRESS=alerts@bluewake.example
